# 复制本文件为 .env 并填入你的 DeepSeek API Key
# 注意：.env 已被 .gitignore 忽略，不会进入版本库 / 构建产物
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：自定义端口 / 模型（一般无需修改）
# PORT=8080
# MODEL=deepseek-chat

# 可选：子路径部署基址。例如部署到 https://host/tuantuan/ 时设为 /tuantuan
# 留空表示根部署。前端会自动按页面路径推断，无需同步设置。
# BASE_PATH=/tuantuan
