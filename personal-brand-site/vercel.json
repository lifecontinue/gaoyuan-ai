{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/classroom-agent/:path*/",
      "destination": "https://ai-classroom-roles-agent.vercel.app/:path*"
    },
    {
      "source": "/classroom-agent/:path*",
      "destination": "https://ai-classroom-roles-agent.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/img/room.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/launch-sync-state",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/launch-sync-state/",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
